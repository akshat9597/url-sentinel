POSTGRES_DB=byteforce
POSTGRES_USER=byteforce
# Render supplies DATABASE_URL automatically from the linked PostgreSQL service.
# These POSTGRES_* values are used by local Docker Compose deployments.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=
BYTEFORCE_ENV=production
BYTEFORCE_OBSERVATION_MODE=true
BYTEFORCE_AUTH_ENABLED=true
BYTEFORCE_SECRET_KEY=replace-with-at-least-32-random-characters
BYTEFORCE_ADMIN_EMAIL=admin@example.com
BYTEFORCE_ADMIN_PASSWORD=replace-with-a-strong-password
BYTEFORCE_AUTO_SEED=false
BYTEFORCE_BOOTSTRAP_MODEL=false
# Use the exact Vercel origin in Render, without a trailing slash.
BYTEFORCE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Add your Render hostname and custom API hostname when deploying publicly.
BYTEFORCE_TRUSTED_HOSTS=localhost,127.0.0.1,*.onrender.com
BYTEFORCE_RETENTION_DAYS=90
BYTEFORCE_MAX_UPLOAD_BYTES=26214400
BYTEFORCE_RATE_LIMIT_PER_MINUTE=120
BYTEFORCE_LOG_WATCH_PATH=
BYTEFORCE_LOG_FORMAT=auto
BYTEFORCE_DEFAULT_HOST=your-owned-domain.example
BYTEFORCE_DEFAULT_DST_IP=127.0.0.1
